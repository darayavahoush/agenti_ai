# Copy to backend/.env for local development. Only DATABASE_URL is required;
# every other value has a default. See the README's "Environment variables"
# section for what each one does. In production these are set as the
# Container App's env vars (see .github/workflows/deploy-staging.yml).

# ---- Database ----
DATABASE_URL=postgresql://postgres:password@localhost:5433/vaaksudhi

# ---- API / CORS ----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Public backend URL, used for links inside emails (e.g. unsubscribe)
API_BASE_URL=http://localhost:8000

# ---- Auth ----
# JWT signing secret. The built-in default is NOT safe outside local dev.
SECRET_KEY=change-me
# Google OAuth Web client ID (same value as the frontend's VITE_GOOGLE_CLIENT_ID).
# Google sign-in returns a 500 if this is empty.
GOOGLE_CLIENT_ID=

# ---- Email (OTP codes + weekly progress email) ----
# Leave SMTP_HOST empty in local dev: codes are logged to the server output instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# App password if using Gmail
SMTP_PASSWORD=

# ---- Feature flags ----
# Only adults (parent/therapist) can create new kid accounts when false.
KID_SELF_SERVICE_SIGNUP_ENABLED=false
# No real payment provider is wired in yet; leave false (see routers/breathquest/billing.py).
PAYMENTS_LIVE=false

# ---- Optional integrations ----
OPENAI_API_KEY=
# X-API-Key for the service-to-service assessment routes
ASSESSMENT_SERVICE_API_KEY=
# AZURE_STORAGE_CONNECTION_STRING=   # left commented: an empty value behaves differently from unset
PIXABAY_API_KEY=
# Whisper model size for Chime verification (default: base)
CHIME_WHISPER_MODEL=base
# Set to false to fail loudly instead of writing a placeholder tone when Coqui TTS errors
TTS_FALLBACK_TO_DUMMY=true

# The Azure Communication Services SMS settings (AZURE_COMMUNICATION_*) are
# intentionally omitted: phone OTP was removed and nothing reads them.
